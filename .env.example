# .env.example — copy what you need into .env (never commit .env)

# ── Live market data: your production tastytrade personal grant, READ-ONLY ──
# my.tastytrade.com → Manage → My Profile → API. Used only to read prices.
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# TASTYTRADE_CLIENT_ID=
TASTYTRADE_SCOPE=read
# Tuning (defaults shown)
# TT_DEFAULT_EXPIRATIONS=1       # expiries returned when a request gives no dates
# TT_MAX_CHAIN_EXPIRATIONS=8     # cap per request
# TT_MAX_OPTION_CONTRACTS=4000   # live option contracts kept streaming (LRU)
# TT_SUB_IDLE_MIN=10             # unsubscribe contracts nobody asked for in N minutes
# TT_FILL_TIMEOUT_MS=3000        # how long a first request waits for Greeks/OI to arrive

# ── Paper Desk ─────────────────────────────────────────────────────────────
# Website login when running on your own machine
PAPER_OWNER_USER=
PAPER_OWNER_PASSWORD=
# Muse's key for /api/paper (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MUSE_PAPER_KEY=
# PAPER_PORT=3100
# PAPER_BIND=127.0.0.1
# local (Basic Auth in the app) | nginx (behind nginx Basic Auth on AWS)
# PAPER_AUTH_MODE=local
# PAPER_KILL=1                    # force the kill switch on
# Live prices: tastytrade (default) | tradeforge (a running TradeForge's /api/options)
# PAPER_MARKET_DATA=tastytrade
# TRADEFORGE_URL=https://127.0.0.1:3000
# Scorecard (fills from live prices): shares you hold for covered calls/strangles, starting cash
# PAPER_SHARES=SPCX:100
# PAPER_STARTING_CASH=100000

# ── tastytrade PAPER (sandbox) account, mirrored on every order ─────────────
# From https://developer.tastytrade.com/docs/sandbox/tools — never the production credentials.
# Leave empty to run scorecard-only.
TT_PAPER_CLIENT_SECRET=
TT_PAPER_REFRESH_TOKEN=
TT_PAPER_ACCOUNT=
# TT_PAPER_CLIENT_ID=
# TT_PAPER_PRICE_STYLE=effect     # effect | signed (npm run paper:spike tells which)
# PAPER_MIRROR=tastytrade         # tastytrade (default when TT_PAPER_* is set) | none
